#!name=机场流量面板(合并·默认3机场·可扩展5)
#!desc=单面板显示多个机场流量/到期，绿色主题，429退避。默认启用前3个机场；如需第4/5个，在下方[Script]的argument行末尾追加 &url4={{{url4}}}&title4=... 并在本段#!arguments补 url4:... 即可（脚本已支持，留空自动隐藏）。
#!system=ios
#!author=基于 cc63/Surge 修改
#!arguments=url:机场1订阅base64, title:机场1名, icon:leaf, color:#22C55E, url2:机场2订阅base64, title2:机场2名, icon2:leaf, color2:#16A34A, url3:机场3订阅base64, title3:机场3名, icon3:leaf, color3:#15803D

[Panel]
机场流量 = script-name=多机场面板,update-interval=86400

[Script]
多机场面板 = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/Mimosass/Surge/main/script/%E5%A4%9A%E6%9C%BA%E5%9C%BA%E9%9D%A2%E6%9D%BF.js,script-update-interval=86400,argument="url={{{url}}}&title={{{title}}}&icon={{{icon}}}&color={{{color}}}&url2={{{url2}}}&title2={{{title2}}}&icon2={{{icon2}}}&color2={{{color2}}}&url3={{{url3}}}&title3={{{title3}}}&icon3={{{icon3}}}&color3={{{color3}}}&url4={{{url4}}}&title4={{{title4}}}&icon4={{{icon4}}}&color4={{{color4}}}&url5={{{url5}}}&title5={{{title5}}}&icon5={{{icon5}}}&color5={{{color5}}}"
